        {
          "id": "codex/trailer",
          "kind": "commit-trailer",
          "pattern": "^co-authored-by:[ \\t]*[^<\\n]*\\(codex\\)[^<\\n]*<[^>\\n]+>|^co-authored-by:[ \\t]*codex\\b[^<\\n]*<[^>\\n]+>",
          "confidence": "high",
          "note": "Codex CLI, e.g. \"gpt-6-astra (Codex) <agent@example.invalid>\" or \"Codex <noreply@openai.com>\""

{
  "version": 3,
  "ignoredAuthors": [
    "dependabot[bot]",
    "dependabot-preview[bot]",
    "renovate[bot]",
    "renovate-bot",
    "github-actions[bot]",
    "pre-commit-ci[bot]",
    "allcontributors[bot]",
    "imgbot[bot]",
    "snyk-bot",
    "greenkeeper[bot]",
    "mergify[bot]",
    "release-please[bot]",
    "changeset-bot[bot]"
  ],
  "agents": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "color": "#8D9DFF",
      "signals": [
        {
          "id": "claude-code/trailer",
          "kind": "commit-trailer",
          "pattern": "^co-authored-by:[ \\t]*claude\\b[^<\\n]*<noreply@anthropic\\.com>",
          "confidence": "high",
          "note": "Added by Claude Code; the name carries the model, e.g. \"Claude Opus 5.5 (1M context)\""
        },
        {
          "id": "claude-code/footer",
          "kind": "commit-message",
          "pattern": "^[^\\S\\n]*(?:🤖[^\\S\\n]*)?generated (?:with|by) \\[?claude code\\]?(?:\\(https?://[^)\\s]+\\))?[^\\S\\n]*\\.?[^\\S\\n]*$",
          "confidence": "high",
          "note": "Default footer \"🤖 Generated with [Claude Code](…)\" on a line of its own"
        },
        {
          "id": "claude-code/author",
          "kind": "commit-author",
          "pattern": "^claude\\[bot\\]$|^noreply@anthropic\\.com$",
          "confidence": "high",
          "note": "Claude GitHub app and Claude Code on the web (account @claude, owned by Anthropic)"
        },
        {
          "id": "claude-code/pr-author",
          "kind": "pr-author",
          "pattern": "^claude(?:\\[bot\\])?$",
          "confidence": "high"
        },
        {
          "id": "claude-code/pr-footer",
          "kind": "pr-body",
          "pattern": "^[^\\S\\n]*(?:🤖[^\\S\\n]*)?generated (?:with|by) \\[?claude code\\]?(?:\\(https?://[^)\\s]+\\))?[^\\S\\n]*\\.?[^\\S\\n]*$",
          "confidence": "high"
        },
        {
          "id": "claude-code/pr-branch",
          "kind": "pr-branch",
          "pattern": "^claude/[^\\s]+$",
          "confidence": "medium",
          "note": "Default branch prefix of Claude Code on the web and the Claude GitHub app"
        }
      ]
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot",
      "color": "#4DB8A4",
      "signals": [
        {
          "id": "copilot/author",
          "kind": "commit-author",
          "pattern": "^copilot(?:-swe-agent)?(?:\\[bot\\])?$",
          "confidence": "high",
          "note": "Copilot coding agent"
        },
        {
          "id": "copilot/trailer",
          "kind": "commit-trailer",
          "pattern": "^co-authored-by:[ \\t]*copilot\\b[^<\\n]*<(?:\\d+\\+)?copilot@users\\.noreply\\.github\\.com>",
          "confidence": "high",
          "note": "Added by Copilot in VS Code and on github.com when AI-generated changes are committed"
        },
        {
          "id": "copilot/pr-author",
          "kind": "pr-author",
          "pattern": "^(?:app/)?copilot(?:-swe-agent)?(?:\\[bot\\])?$",
          "confidence": "high"
        },
        {
          "id": "copilot/pr-branch",
          "kind": "pr-branch",
          "pattern": "^copilot/[^\\s]+$",
          "confidence": "medium",
          "note": "Default branch prefix of the Copilot coding agent"
        }
      ]
    },
    {
      "id": "codex",

{
  "name": "howmuchai",
  "version": "0.1.0",
  "description": "How much of this repo was built with AI? Measures commits and pull requests that carry an AI coding-agent signature.",
  "type": "module",
  "license": "MIT",
  "author": "Maximilian Feix",
  "homepage": "https://maximilianfeix.github.io/howmuchai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/howmuchai.git"
  },
  "bin": {
    "howmuchai": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:cli && npm run build:action",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.mjs --banner:js='#!/usr/bin/env node'",
    "crawl": "tsx scripts/crawl.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:action": "esbuild src/action/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=action/index.mjs",
    "site": "vite build && tsx scripts/assemble.ts --site dist/site --data .data",
    "eval": "tsx scripts/evaluate.ts",
    "e2e": "vite build && tsx e2e/make-fixtures.ts && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
